# Copy to .env and fill in to enable accounts and cloud sync.
#
# WITHOUT these the app still works completely — it runs in guest mode and
# keeps everything in localStorage. Accounts are an optional layer, not a
# requirement, so a fresh clone runs with `npm install && npm run dev`.
#
# All three values are PUBLIC by design. A Vite build inlines VITE_* variables
# into the JavaScript bundle, so treat them as visible to anyone. Security
# comes from Row Level Security in Postgres (see db/migrations/001_init.sql),
# never from hiding these strings.
#
# To get your own, see README "Setting up accounts and sync".

# Stack Auth project, created by Neon Auth.
VITE_STACK_PROJECT_ID=
VITE_STACK_PUBLISHABLE_CLIENT_KEY=

# Neon Data API (PostgREST) endpoint for your branch.
VITE_NEON_DATA_API_URL=
