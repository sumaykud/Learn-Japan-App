[
  {
    "id": "0036ab32",
    "text": "よろしければ"
  },
  {
    "id": "00e2ca97",
    "text": "イギリスから来ました。ロンドンに住んでいました。"
  },
  {
    "id": "01640dae",
    "text": "始める"
  },
  {
    "id": "017f0c05",
    "text": "送る"
  },
  {
    "id": "01c7514f",
    "text": "かしこまりました。こちらのお席へどうぞ。"
  },
  {
    "id": "02103bf1",
    "text": "今日は飲まないつもりです。"
  },
  {
    "id": "024fed07",
    "text": "忙しい"
  },
  {
    "id": "02d06ba0",
    "text": "もちろん"
  },
  {
    "id": "02e813d3",
    "text": "アニメ映画です。すごく面白かったですよ。ぜひ見てください。"
  },
  {
    "id": "030f5630",
    "text": "在庫がございますので、三日以内に発送させていただきます。"
  },
  {
    "id": "031c000f",
    "text": "飲む"
  },
  {
    "id": "035780b7",
    "text": "どのくらい違いますか。"
  },
  {
    "id": "037d4546",
    "text": "悲しい"
  },
  {
    "id": "043df049",
    "text": "一緒に昼ごはんを食べませんか。"
  },
  {
    "id": "04ccb6ac",
    "text": "帰る"
  },
  {
    "id": "04dde371",
    "text": "来る"
  },
  {
    "id": "050b9e9a",
    "text": "ありがとう。話したら少しすっきりした。"
  },
  {
    "id": "05a26d82",
    "text": "電車で会社に行きます。"
  },
  {
    "id": "06a85db2",
    "text": "家族"
  },
  {
    "id": "06ae418b",
    "text": "有名"
  },
  {
    "id": "06f70662",
    "text": "テレビをつけたまま寝てしまいました。"
  },
  {
    "id": "070fc2cd",
    "text": "急がなくてもいいですよ。"
  },
  {
    "id": "0736c029",
    "text": "足りる"
  },
  {
    "id": "074928fd",
    "text": "制度"
  },
  {
    "id": "07683c13",
    "text": "昨日届いたんですが、箱が壊れていて、中身にも傷がついていました。"
  },
  {
    "id": "07bb6275",
    "text": "ありがとうございます。助かります。"
  },
  {
    "id": "07e39a47",
    "text": "かしこまりました。条件を少し変えて、何件かお持ちします。"
  },
  {
    "id": "07f7afc6",
    "text": "その仕事を私にやらせてください。"
  },
  {
    "id": "082d8483",
    "text": "写真を撮ってもいいですか。"
  },
  {
    "id": "0874e4d0",
    "text": "この経験を通じて多くのことを学びました。"
  },
  {
    "id": "089f6499",
    "text": "本とお菓子です。ここに書けばいいですか。"
  },
  {
    "id": "09670cf1",
    "text": "お世話になっております。先週注文した商品のことでご連絡しました。"
  },
  {
    "id": "09a4c132",
    "text": "これは私の本です。"
  },
  {
    "id": "0a04718a",
    "text": "苦しい"
  },
  {
    "id": "0a641458",
    "text": "書く"
  },
  {
    "id": "0b38b33d",
    "text": "新しい制度をめぐって議論が続いている。"
  },
  {
    "id": "0bad9366",
    "text": "育てる"
  },
  {
    "id": "0c119984",
    "text": "助かります。確認のうえ、交換か返金かお選びいただけます。"
  },
  {
    "id": "0c172efe",
    "text": "家賃"
  },
  {
    "id": "0da8cffc",
    "text": "すごいですね。分からないことがあったら、聞いてください。"
  },
  {
    "id": "0e09f891",
    "text": "厳しい"
  },
  {
    "id": "0ead08f3",
    "text": "誘う"
  },
  {
    "id": "0eeeeb47",
    "text": "申し訳ありませんが、今回は遠慮させていただきます。"
  },
  {
    "id": "0f291f2f",
    "text": "小さい"
  },
  {
    "id": "0fadd951",
    "text": "詳しい"
  },
  {
    "id": "0fcd8039",
    "text": "謝る"
  },
  {
    "id": "10c148ec",
    "text": "行く"
  },
  {
    "id": "119dd9c4",
    "text": "保守サポートの範囲を一年に短縮する、あるいは一部のカスタマイズを省く、という案が考えられます。"
  },
  {
    "id": "124cec78",
    "text": "失礼します"
  },
  {
    "id": "125efd29",
    "text": "それで効率は落ちませんか。"
  },
  {
    "id": "12651f00",
    "text": "給料"
  },
  {
    "id": "12b0e790",
    "text": "とはいえ、若手の育成という観点では対面のほうが効率がいいのでは。"
  },
  {
    "id": "12ce889d",
    "text": "乏しい"
  },
  {
    "id": "12f9da60",
    "text": "料理があまり上手じゃありません。"
  },
  {
    "id": "12fda363",
    "text": "慣れる"
  },
  {
    "id": "1326afd3",
    "text": "会議は三時に始まるはずです。"
  },
  {
    "id": "133f22c7",
    "text": "多少の負担は伴いますが、手戻りが減る分、全体としてはむしろ改善すると見ております。"
  },
  {
    "id": "1368e969",
    "text": "はい、準備ができ次第、すぐにご連絡いたします。"
  },
  {
    "id": "13bb5d63",
    "text": "減る"
  },
  {
    "id": "1428602c",
    "text": "今日はどうされましたか。"
  },
  {
    "id": "142ffc76",
    "text": "日本の音楽が好きです。"
  },
  {
    "id": "146605fe",
    "text": "正直に申しますと、敬語はまだ勉強中です。ただ、毎日続けているので、少しずつ慣れてきました。"
  },
  {
    "id": "14cc451e",
    "text": "含む"
  },
  {
    "id": "1551ca51",
    "text": "日当たりはどうですか。南向きだと嬉しいんですが。"
  },
  {
    "id": "1568bae3",
    "text": "増える"
  },
  {
    "id": "15741f4b",
    "text": "すみません、お会計をお願いします。別々でできますか。"
  },
  {
    "id": "15db56e3",
    "text": "毎日日本語を勉強します。"
  },
  {
    "id": "1650609f",
    "text": "説明"
  },
  {
    "id": "16c23029",
    "text": "はい。スミスと申します。前の会社では三年間営業を担当しておりました。"
  },
  {
    "id": "17028947",
    "text": "すみません、駅はどこですか。"
  },
  {
    "id": "17379470",
    "text": "これまでの仕事で一番大変だったことは何ですか。"
  },
  {
    "id": "174962c4",
    "text": "新しい"
  },
  {
    "id": "1780d8c5",
    "text": "提案"
  },
  {
    "id": "17af2045",
    "text": "手配"
  },
  {
    "id": "17d7c0cf",
    "text": "果たす"
  },
  {
    "id": "1802febc",
    "text": "したがって"
  },
  {
    "id": "180968c5",
    "text": "この方法は効率がいい反面、費用がかかる。"
  },
  {
    "id": "1881c752",
    "text": "確か"
  },
  {
    "id": "189ee208",
    "text": "朝"
  },
  {
    "id": "1949e19b",
    "text": "夜"
  },
  {
    "id": "1a242dc1",
    "text": "値段は安いものの、品質に問題がある。"
  },
  {
    "id": "1a400375",
    "text": "人によって考え方が違います。"
  },
  {
    "id": "1a74bfa3",
    "text": "心配しないでください。"
  },
  {
    "id": "1ab2ff3f",
    "text": "極めて"
  },
  {
    "id": "1ba434e9",
    "text": "結果"
  },
  {
    "id": "1c94195c",
    "text": "簡単"
  },
  {
    "id": "1d4cf2ab",
    "text": "至る"
  },
  {
    "id": "1d6b7d90",
    "text": "買う"
  },
  {
    "id": "1d79d0ef",
    "text": "今日は春らしい天気ですね。"
  },
  {
    "id": "1dc2d67f",
    "text": "元気"
  },
  {
    "id": "1e30468a",
    "text": "受ける"
  },
  {
    "id": "1e3804d7",
    "text": "えっ、今の会社、悪くないって言ってなかった？"
  },
  {
    "id": "1e607d1a",
    "text": "カードでお願いします。"
  },
  {
    "id": "1f2f40f7",
    "text": "私は先生じゃありません。"
  },
  {
    "id": "1f7a75d0",
    "text": "迷う"
  },
  {
    "id": "1feb1ac3",
    "text": "念頭に置く"
  },
  {
    "id": "20cfa6ba",
    "text": "判断"
  },
  {
    "id": "20cfd049",
    "text": "感謝"
  },
  {
    "id": "2178cbb5",
    "text": "信じる"
  },
  {
    "id": "219c9147",
    "text": "生ビールを一つと、お水をお願いします。"
  },
  {
    "id": "21c302c7",
    "text": "予算に応じて計画を見直します。"
  },
  {
    "id": "2371bfba",
    "text": "需要"
  },
  {
    "id": "240dc305",
    "text": "彼女が知らないはずがありません。"
  },
  {
    "id": "242d6c2d",
    "text": "先生、質問があります。"
  },
  {
    "id": "2457d02a",
    "text": "ご注文はお決まりですか。"
  },
  {
    "id": "24ad88dc",
    "text": "示す"
  },
  {
    "id": "24fb104d",
    "text": "パンを買いに行きます。"
  },
  {
    "id": "2608f3e2",
    "text": "ここに名前を書いてください。"
  },
  {
    "id": "26675b0b",
    "text": "分かりました。では、よろしくお願いいたします。"
  },
  {
    "id": "26fab168",
    "text": "契約"
  },
  {
    "id": "271a0938",
    "text": "先生"
  },
  {
    "id": "273ac0d7",
    "text": "締め切り"
  },
  {
    "id": "27711986",
    "text": "漢字が読めるようになりました。"
  },
  {
    "id": "27797f7e",
    "text": "お電話ありがとうございます。さくら亭でございます。"
  },
  {
    "id": "27aab3cb",
    "text": "どのようなお部屋をお探しですか。"
  },
  {
    "id": "283dcac2",
    "text": "兄は静かなのに対して、弟はよくしゃべります。"
  },
  {
    "id": "28486638",
    "text": "席"
  },
  {
    "id": "284ca7fd",
    "text": "でしょう。だから週三日くらいが妥当じゃないかと。"
  },
  {
    "id": "28872958",
    "text": "あの店は安いです。"
  },
  {
    "id": "28cb42f3",
    "text": "その方法は難しいと思います。"
  },
  {
    "id": "28e507a9",
    "text": "本日は私が説明させていただきます。"
  },
  {
    "id": "299efccb",
    "text": "本"
  },
  {
    "id": "29b8ea7b",
    "text": "必ずしも"
  },
  {
    "id": "29f35dbd",
    "text": "いつもありがとうございます。どのようなご用件でしょうか。"
  },
  {
    "id": "2a2d9469",
    "text": "宿題はもうやってしまいました。"
  },
  {
    "id": "2acfa8f4",
    "text": "守る"
  },
  {
    "id": "2b1da0e5",
    "text": "取り組む"
  },
  {
    "id": "2b3cd1e1",
    "text": "いらっしゃいませ。何名様ですか。"
  },
  {
    "id": "2b59eae9",
    "text": "このボタンを押せばドアが開きます。"
  },
  {
    "id": "2c605f35",
    "text": "抑える"
  },
  {
    "id": "2c78f313",
    "text": "今日は何もしたくないです。"
  },
  {
    "id": "2c87f491",
    "text": "急に"
  },
  {
    "id": "2caf2e15",
    "text": "なるほど。それで、どうしたいと考えていますか。"
  },
  {
    "id": "2cb2046f",
    "text": "終わる"
  },
  {
    "id": "2d208dfb",
    "text": "先生に説明してもらいました。"
  },
  {
    "id": "2d3ef58d",
    "text": "荷物"
  },
  {
    "id": "2d55a299",
    "text": "影響"
  },
  {
    "id": "2de57d84",
    "text": "はい、こちらが追跡番号です。大切にお持ちください。"
  },
  {
    "id": "2e144a8e",
    "text": "望む"
  },
  {
    "id": "2e23adfa",
    "text": "連絡先が分からないので、知らせようがありません。"
  },
  {
    "id": "2e2fb600",
    "text": "はじめまして"
  },
  {
    "id": "2e8c20aa",
    "text": "猫"
  },
  {
    "id": "2ef6aad8",
    "text": "前提"
  },
  {
    "id": "2ef8f023",
    "text": "暮らす"
  },
  {
    "id": "2f7696e0",
    "text": "予算"
  },
  {
    "id": "3008ca0e",
    "text": "直す"
  },
  {
    "id": "30177ac5",
    "text": "原因は把握されていますか。"
  },
  {
    "id": "303f37da",
    "text": "明日東京に行きます。"
  },
  {
    "id": "305890b3",
    "text": "会議においてこの問題が議論されました。"
  },
  {
    "id": "31282f95",
    "text": "お待たせしてすみません。"
  },
  {
    "id": "3130a02f",
    "text": "意見"
  },
  {
    "id": "3190de63",
    "text": "水"
  },
  {
    "id": "31b9320a",
    "text": "すみません、これはどんな料理ですか。"
  },
  {
    "id": "3203d6d2",
    "text": "努力"
  },
  {
    "id": "333cc778",
    "text": "いいえ、気をつけて。"
  },
  {
    "id": "338dbb89",
    "text": "父"
  },
  {
    "id": "33ac90ce",
    "text": "変わる"
  },
  {
    "id": "34674032",
    "text": "いいですね。何の映画でしたか。"
  },
  {
    "id": "34a49ada",
    "text": "怒る"
  },
  {
    "id": "35485fbb",
    "text": "規則"
  },
  {
    "id": "35490374",
    "text": "お飲み物はいかがなさいますか。"
  },
  {
    "id": "359a5b9e",
    "text": "ちょっと相談したいことがあるんだけど、今時間ある？"
  },
  {
    "id": "35fb42c9",
    "text": "効率"
  },
  {
    "id": "36c67d18",
    "text": "今出かけるところです。"
  },
  {
    "id": "38927467",
    "text": "いくら"
  },
  {
    "id": "39a0a8fb",
    "text": "昼"
  },
  {
    "id": "39c6eaa6",
    "text": "一年を通じて気温が安定しています。"
  },
  {
    "id": "3ab1ba7a",
    "text": "分かりました。何かご質問はありますか。"
  },
  {
    "id": "3aee69b3",
    "text": "航空便なら一週間くらい、船便なら一か月ほどかかります。"
  },
  {
    "id": "3b029480",
    "text": "国内のみならず海外でも高く評価されている。"
  },
  {
    "id": "3b14b18d",
    "text": "間に合う"
  },
  {
    "id": "3b6fce76",
    "text": "すみません、もう一度ゆっくりお願いします。"
  },
  {
    "id": "3ca877c8",
    "text": "かしこまりました。少々お待ちください。"
  },
  {
    "id": "3d5bb232",
    "text": "Mサイズでお願いします。"
  },
  {
    "id": "3deb9d79",
    "text": "恐れ入りますが"
  },
  {
    "id": "3e98b842",
    "text": "できれば交換していただきたいです。いつごろになりますか。"
  },
  {
    "id": "3e9d468e",
    "text": "笑う"
  },
  {
    "id": "3efeafb6",
    "text": "応じる"
  },
  {
    "id": "3f1a4c00",
    "text": "駅"
  },
  {
    "id": "3f489a54",
    "text": "いいえ、まだまだです。でも毎日勉強しています。"
  },
  {
    "id": "3fcfdfd0",
    "text": "若いうちにいろいろな経験をしたほうがいいです。"
  },
  {
    "id": "40c59ba6",
    "text": "どう"
  },
  {
    "id": "40d4982a",
    "text": "会議の前に資料を読んでおきます。"
  },
  {
    "id": "4181f229",
    "text": "もしもし、予約をお願いしたいんですが。"
  },
  {
    "id": "41924774",
    "text": "駅から家まで歩きます。"
  },
  {
    "id": "42340a61",
    "text": "仕事"
  },
  {
    "id": "427d0e79",
    "text": "寝る"
  },
  {
    "id": "429680d5",
    "text": "面倒"
  },
  {
    "id": "429b510a",
    "text": "彼はもう帰ったかもしれません。"
  },
  {
    "id": "42bc3193",
    "text": "二時からです。資料はもう準備できていますか。"
  },
  {
    "id": "43acf130",
    "text": "はい。それから二つ目の信号を右に曲がってください。"
  },
  {
    "id": "43fd4778",
    "text": "いいえ、大丈夫です。"
  },
  {
    "id": "44667411",
    "text": "少々お待ちください。……お待たせしました。七時は満席ですが、七時半ならご案内できます。"
  },
  {
    "id": "447af24c",
    "text": "私"
  },
  {
    "id": "44b764bd",
    "text": "彼は謝るどころか、怒り出した。"
  },
  {
    "id": "4553cca1",
    "text": "悪いわけじゃないんだけど、このまま続けても成長できない気がして。"
  },
  {
    "id": "45650ed6",
    "text": "一割ほど抑えていただけると助かります。"
  },
  {
    "id": "463fff70",
    "text": "羨ましい"
  },
  {
    "id": "467ede30",
    "text": "認める"
  },
  {
    "id": "47538dca",
    "text": "原因"
  },
  {
    "id": "476f31a3",
    "text": "預ける"
  },
  {
    "id": "4836a2cc",
    "text": "悩む"
  },
  {
    "id": "4861f5db",
    "text": "珍しい"
  },
  {
    "id": "48974e98",
    "text": "母"
  },
  {
    "id": "4a37bf33",
    "text": "漢字どころか、ひらがなもまだ書けません。"
  },
  {
    "id": "4ab28106",
    "text": "ちょうど南向きです。ただし、前に建物があるので、午後は少し暗くなるかもしれません。"
  },
  {
    "id": "4ad35069",
    "text": "天気"
  },
  {
    "id": "4b1ba45c",
    "text": "分かりました。では、対応方針を書面でいただけますか。"
  },
  {
    "id": "4bb6fea1",
    "text": "はい、A1234です。写真も撮ってあるので、必要でしたらお送りします。"
  },
  {
    "id": "4ce29ee1",
    "text": "眠い"
  },
  {
    "id": "4d300ecf",
    "text": "むしろ"
  },
  {
    "id": "4d39546c",
    "text": "働きながら大学に通っています。"
  },
  {
    "id": "4e32009d",
    "text": "車"
  },
  {
    "id": "4ed98774",
    "text": "休む"
  },
  {
    "id": "4f60409d",
    "text": "今"
  },
  {
    "id": "4f733773",
    "text": "すみません"
  },
  {
    "id": "4f785887",
    "text": "分かる"
  },
  {
    "id": "4fbd1a71",
    "text": "丁寧"
  },
  {
    "id": "4fc312c8",
    "text": "もう一度言ってください。"
  },
  {
    "id": "501052d8",
    "text": "理由"
  },
  {
    "id": "50c4dd2c",
    "text": "お見積もりを拝見しましたが、正直、予算を超えております。"
  },
  {
    "id": "51256c2f",
    "text": "窓は開けておいてください。"
  },
  {
    "id": "516d53db",
    "text": "日本に来たばかりなので、まだ慣れていません。"
  },
  {
    "id": "519df1f0",
    "text": "電車"
  },
  {
    "id": "525f48bd",
    "text": "財布"
  },
  {
    "id": "5309310f",
    "text": "机の上に本があります。"
  },
  {
    "id": "55c5bcb5",
    "text": "どこ"
  },
  {
    "id": "55e442a2",
    "text": "時間"
  },
  {
    "id": "567bb368",
    "text": "申し訳ありません"
  },
  {
    "id": "56dd904f",
    "text": "明日は雨が降ると思います。"
  },
  {
    "id": "56e72183",
    "text": "納豆は食べたことがありません。"
  },
  {
    "id": "570ed4dc",
    "text": "業界"
  },
  {
    "id": "5733a575",
    "text": "お願いします。来週までにいただけますか。"
  },
  {
    "id": "579a4497",
    "text": "怖い"
  },
  {
    "id": "57de17f2",
    "text": "学生"
  },
  {
    "id": "57ecc895",
    "text": "抱える"
  },
  {
    "id": "5853148f",
    "text": "だから"
  },
  {
    "id": "58702d31",
    "text": "東京に住んでいます。"
  },
  {
    "id": "587d5cb9",
    "text": "わざわざ"
  },
  {
    "id": "598c0862",
    "text": "おはようございます。今日も暑いですね。"
  },
  {
    "id": "598dcaa4",
    "text": "とはいえ"
  },
  {
    "id": "59e6cbd5",
    "text": "京都に行ったことがあります。"
  },
  {
    "id": "5a62c4bd",
    "text": "遅れる"
  },
  {
    "id": "5b003924",
    "text": "自由"
  },
  {
    "id": "5b4bef40",
    "text": "相談"
  },
  {
    "id": "5b6bc5ad",
    "text": "資料"
  },
  {
    "id": "5cc5e2c3",
    "text": "占める"
  },
  {
    "id": "5ccc7b71",
    "text": "合計で四百八十円になります。"
  },
  {
    "id": "5d0b5f4b",
    "text": "大変申し訳ございません。ご注文番号をお伺いしてもよろしいでしょうか。"
  },
  {
    "id": "5d57b4ea",
    "text": "友達が手伝ってくれました。"
  },
  {
    "id": "5e1055ca",
    "text": "安かったら買います。"
  },
  {
    "id": "5e1ee1e7",
    "text": "義務"
  },
  {
    "id": "5e5ee35d",
    "text": "袋はご利用ですか。"
  },
  {
    "id": "5e86abdd",
    "text": "決める"
  },
  {
    "id": "5f1cdbd1",
    "text": "この漢字は何と読みますか。"
  },
  {
    "id": "6084c68d",
    "text": "お世話になっております"
  },
  {
    "id": "60ac1e7a",
    "text": "我慢"
  },
  {
    "id": "6189979a",
    "text": "食べる"
  },
  {
    "id": "622cdadd",
    "text": "じゃあ、七時半でお願いします。"
  },
  {
    "id": "6230ddf7",
    "text": "はい、できます。レジで承ります。"
  },
  {
    "id": "623bc3dd",
    "text": "実は、転職しようかどうか迷ってるんだ。"
  },
  {
    "id": "634074a5",
    "text": "深刻"
  },
  {
    "id": "634d4b03",
    "text": "特別"
  },
  {
    "id": "63611ddc",
    "text": "ありがとうございます"
  },
  {
    "id": "63a46734",
    "text": "探す"
  },
  {
    "id": "64ac5b22",
    "text": "九時から五時まで働きます。"
  },
  {
    "id": "6506aa3c",
    "text": "これはいくらですか。"
  },
  {
    "id": "66fbbdfd",
    "text": "二、三日は休んで、ゆっくり寝てください。薬を出しておきます。"
  },
  {
    "id": "6718936a",
    "text": "雨にもかかわらず、多くの人が集まりました。"
  },
  {
    "id": "68356178",
    "text": "円滑"
  },
  {
    "id": "6839e848",
    "text": "ここからどのくらいかかりますか。"
  },
  {
    "id": "68979c58",
    "text": "はい。確認の工程が一部省かれていたことが原因でした。担当者の判断に頼りすぎていた点は否定できません。"
  },
  {
    "id": "68b744a5",
    "text": "あくまで"
  },
  {
    "id": "68d4e2a4",
    "text": "一概に"
  },
  {
    "id": "68f714b9",
    "text": "朝ごはんを食べずに出かけました。"
  },
  {
    "id": "699d617a",
    "text": "はい、お願いします。仕事は休んだほうがいいですか。"
  },
  {
    "id": "69d15f8f",
    "text": "大きい"
  },
  {
    "id": "6a2a3f41",
    "text": "たぶん"
  },
  {
    "id": "6a378a0d",
    "text": "続ける"
  },
  {
    "id": "6a92cfc4",
    "text": "環境"
  },
  {
    "id": "6aefd867",
    "text": "率直なご意見をありがとうございます。差し支えなければ、ご予算の目安をお聞かせいただけますか。"
  },
  {
    "id": "6ba6d981",
    "text": "難しい"
  },
  {
    "id": "6bd4df85",
    "text": "さすが"
  },
  {
    "id": "6c0f3030",
    "text": "与える"
  },
  {
    "id": "6c1b7042",
    "text": "払う"
  },
  {
    "id": "6c20a25b",
    "text": "公園"
  },
  {
    "id": "6c22c46b",
    "text": "きっと"
  },
  {
    "id": "6c49de25",
    "text": "電車よりバスのほうが安いです。"
  },
  {
    "id": "6c519527",
    "text": "現状のスケジュールについて、一点提案がございます。"
  },
  {
    "id": "6c5afbe8",
    "text": "今日"
  },
  {
    "id": "6d075d95",
    "text": "飲み物"
  },
  {
    "id": "6d66152f",
    "text": "気持ちは分かる。でも焦って決めないほうがいいよ。"
  },
  {
    "id": "6da04673",
    "text": "中身は何でしょうか。この用紙にご記入ください。"
  },
  {
    "id": "6dac7def",
    "text": "この建物は有名な建築家によって設計されました。"
  },
  {
    "id": "6dac9aa5",
    "text": "関係"
  },
  {
    "id": "6e56090c",
    "text": "助ける"
  },
  {
    "id": "6e5df4d8",
    "text": "状況"
  },
  {
    "id": "6f384be8",
    "text": "暑い"
  },
  {
    "id": "6f638315",
    "text": "なるほど。初期費用は全部でいくらぐらいになりますか。"
  },
  {
    "id": "6f6470c9",
    "text": "能力"
  },
  {
    "id": "6fb51031",
    "text": "好ましい"
  },
  {
    "id": "7027bcf3",
    "text": "作業量の増加に伴って、締め切りに間に合わない可能性が出てきました。"
  },
  {
    "id": "7137b4d6",
    "text": "そろそろ行きましょう。"
  },
  {
    "id": "71d8cc4a",
    "text": "曖昧"
  },
  {
    "id": "722c11d9",
    "text": "それがいいと思う。動けば動くほど見えてくるものもあるしね。"
  },
  {
    "id": "7239e710",
    "text": "責任"
  },
  {
    "id": "72847a42",
    "text": "忘れないようにメモしておきます。"
  },
  {
    "id": "742daf4c",
    "text": "円安に伴い、輸入価格が上がった。"
  },
  {
    "id": "749e1f84",
    "text": "私は学生です。"
  },
  {
    "id": "74b5fc44",
    "text": "態度"
  },
  {
    "id": "75278d22",
    "text": "ありがとうございます。何名様でしょうか。"
  },
  {
    "id": "75534ff2",
    "text": "お客様に対して失礼な態度をとってはいけません。"
  },
  {
    "id": "76959028",
    "text": "読む"
  },
  {
    "id": "776d64e2",
    "text": "例えば"
  },
  {
    "id": "78060bb1",
    "text": "明確"
  },
  {
    "id": "795a396f",
    "text": "目的"
  },
  {
    "id": "79f84569",
    "text": "今食べているところなので、後でかけ直します。"
  },
  {
    "id": "7b5c9738",
    "text": "追跡はできますか。"
  },
  {
    "id": "7b752df8",
    "text": "そうですね。ただ、一概に出社に戻せばいいというものでもないと思います。"
  },
  {
    "id": "7cb92523",
    "text": "日本語の本を買いました。"
  },
  {
    "id": "7cd4d617",
    "text": "ご検討ください"
  },
  {
    "id": "7d6e3337",
    "text": "嬉しい"
  },
  {
    "id": "7d7d7223",
    "text": "田中さんは会社員ですか。"
  },
  {
    "id": "7d9dcf37",
    "text": "お先に失礼します"
  },
  {
    "id": "7ddd96f0",
    "text": "その点は認めざるを得ません。実際、気軽に質問できる環境は大きいですから。"
  },
  {
    "id": "7ef80dba",
    "text": "分かりました。風邪だと思いますが、念のため検査をしましょう。"
  },
  {
    "id": "7efb5f0b",
    "text": "ぜひ"
  },
  {
    "id": "7efec0df",
    "text": "考える"
  },
  {
    "id": "7fc42315",
    "text": "はい。先月の実績を見ると、予定の七割ほどしか進んでいません。このままでは品質にも影響を及ぼしかねません。"
  },
  {
    "id": "7fcb348e",
    "text": "日本語での業務に不安はありませんか。"
  },
  {
    "id": "801be77b",
    "text": "内容"
  },
  {
    "id": "803a1095",
    "text": "分野"
  },
  {
    "id": "806d1f0c",
    "text": "映画"
  },
  {
    "id": "80b838a7",
    "text": "割合"
  },
  {
    "id": "80f88c90",
    "text": "準備"
  },
  {
    "id": "81408b52",
    "text": "そういえば、午後の会議は何時からですか。"
  },
  {
    "id": "81cbef8e",
    "text": "性格"
  },
  {
    "id": "822d77df",
    "text": "明日は来なくてもいいです。"
  },
  {
    "id": "82578e49",
    "text": "壁に予定表が貼ってあります。"
  },
  {
    "id": "828c7373",
    "text": "とても"
  },
  {
    "id": "82974a36",
    "text": "はい、どうぞ。"
  },
  {
    "id": "83abf4c7",
    "text": "事故のために電車が止まりました。"
  },
  {
    "id": "83b25ee9",
    "text": "再発防止策は。"
  },
  {
    "id": "845c1155",
    "text": "いつ"
  },
  {
    "id": "848934d1",
    "text": "素直"
  },
  {
    "id": "84c3b035",
    "text": "基づく"
  },
  {
    "id": "84e4127a",
    "text": "念のため"
  },
  {
    "id": "85d8816c",
    "text": "春になると桜が咲きます。"
  },
  {
    "id": "87060cc3",
    "text": "はい、一つお願いします。"
  },
  {
    "id": "8726efae",
    "text": "必ず"
  },
  {
    "id": "87392c6f",
    "text": "一方で"
  },
  {
    "id": "891d2599",
    "text": "集める"
  },
  {
    "id": "89606870",
    "text": "駅から歩いて十分以内で、家賃は八万円くらいまでがいいんですが。"
  },
  {
    "id": "8971a06e",
    "text": "優しい"
  },
  {
    "id": "89811853",
    "text": "見る"
  },
  {
    "id": "8988a150",
    "text": "しかし"
  },
  {
    "id": "89d92821",
    "text": "自分"
  },
  {
    "id": "89dac4e6",
    "text": "いらっしゃいませ。"
  },
  {
    "id": "89e408b6",
    "text": "変化"
  },
  {
    "id": "89fc4fa8",
    "text": "学校"
  },
  {
    "id": "8a6d56af",
    "text": "この本を一日で読みきりました。"
  },
  {
    "id": "8a7fb552",
    "text": "図書館"
  },
  {
    "id": "8a938965",
    "text": "便利"
  },
  {
    "id": "8b0deaca",
    "text": "その代わり"
  },
  {
    "id": "8ba327a3",
    "text": "では、簡単に自己紹介をお願いします。"
  },
  {
    "id": "8bb349c0",
    "text": "面接"
  },
  {
    "id": "8be44728",
    "text": "熱いうちに召し上がってください。"
  },
  {
    "id": "8bf4f9dd",
    "text": "パーティーで食べたり飲んだりしました。"
  },
  {
    "id": "8c365f50",
    "text": "そのケーキ、おいしそうですね。"
  },
  {
    "id": "8cb76135",
    "text": "支払う"
  },
  {
    "id": "8cc7feba",
    "text": "マイクさんはどちらから来ましたか。"
  },
  {
    "id": "8d25016a",
    "text": "お手数をおかけしますが"
  },
  {
    "id": "8d46349f",
    "text": "比べる"
  },
  {
    "id": "8d69970a",
    "text": "ある"
  },
  {
    "id": "8d77e07c",
    "text": "本当に。昨日より暑い気がします。"
  },
  {
    "id": "8ee24188",
    "text": "任せる"
  },
  {
    "id": "8ee2a089",
    "text": "手伝う"
  },
  {
    "id": "8f58558c",
    "text": "矛盾"
  },
  {
    "id": "8fe01ef9",
    "text": "日本に行きたいです。"
  },
  {
    "id": "90a616d7",
    "text": "少し痛いです。それに、咳も出ます。"
  },
  {
    "id": "91278820",
    "text": "お疲れ様でした"
  },
  {
    "id": "91888ea7",
    "text": "練習すればするほど上手になります。"
  },
  {
    "id": "91c6c970",
    "text": "はい、昨日のうちに作っておきました。"
  },
  {
    "id": "921ba260",
    "text": "頑張る"
  },
  {
    "id": "9229902c",
    "text": "待つ"
  },
  {
    "id": "9237ed69",
    "text": "ご注文がお決まりになりましたらお呼びください。"
  },
  {
    "id": "92477a16",
    "text": "店"
  },
  {
    "id": "928fc632",
    "text": "価格のみならず、品質も重要だ。"
  },
  {
    "id": "930d34bf",
    "text": "この店は人気があるそうです。"
  },
  {
    "id": "95d86cf8",
    "text": "予約はもうしてあります。"
  },
  {
    "id": "9669b449",
    "text": "会社"
  },
  {
    "id": "96b39f5c",
    "text": "無理をしないほうがいいです。"
  },
  {
    "id": "96c52e25",
    "text": "迷惑"
  },
  {
    "id": "96f47795",
    "text": "済む"
  },
  {
    "id": "96f822ec",
    "text": "困る"
  },
  {
    "id": "978518e4",
    "text": "全部分かったわけではありません。"
  },
  {
    "id": "9794e0d8",
    "text": "かしこまりました。お名前をお伺いしてもよろしいですか。"
  },
  {
    "id": "980d175b",
    "text": "週末は本を読んだり映画を見たりします。"
  },
  {
    "id": "9825bc76",
    "text": "そのままだと大きな問題になりかねません。"
  },
  {
    "id": "98481e13",
    "text": "日本で働くために日本語を勉強しています。"
  },
  {
    "id": "98cb16cf",
    "text": "進む"
  },
  {
    "id": "99636df7",
    "text": "お願いします"
  },
  {
    "id": "99b317d4",
    "text": "激しい"
  },
  {
    "id": "9a3b5910",
    "text": "傾向"
  },
  {
    "id": "9adc4d16",
    "text": "届く"
  },
  {
    "id": "9b2d8ea4",
    "text": "努力したにもかかわらず、結果は出なかった。"
  },
  {
    "id": "9b4021e4",
    "text": "面白い"
  },
  {
    "id": "9b6383d7",
    "text": "分かりました。ありがとうございます。"
  },
  {
    "id": "9bd5e37a",
    "text": "導く"
  },
  {
    "id": "9be1ac06",
    "text": "田中さんは転職するらしいです。"
  },
  {
    "id": "9c31317e",
    "text": "二つ案があります。納期を二週間延ばすか、一部の機能を次のリリースに回すかです。"
  },
  {
    "id": "9c88320d",
    "text": "教える"
  },
  {
    "id": "9ce64ccd",
    "text": "ごちそうさまでした"
  },
  {
    "id": "9d1eca68",
    "text": "喉は痛くないですか。"
  },
  {
    "id": "9d574967",
    "text": "傘"
  },
  {
    "id": "9d900db9",
    "text": "パンと卵を買いました。"
  },
  {
    "id": "9d9ebd1f",
    "text": "トイレ"
  },
  {
    "id": "9dbfe851",
    "text": "朝ごはんを食べます。"
  },
  {
    "id": "9def0354",
    "text": "駅ですか。この道をまっすぐ行ってください。"
  },
  {
    "id": "9ebf1a45",
    "text": "求める"
  },
  {
    "id": "9f5e3149",
    "text": "断る"
  },
  {
    "id": "a00cb4f0",
    "text": "はじめまして。田中です。よろしくお願いします。"
  },
  {
    "id": "a1d57690",
    "text": "確保"
  },
  {
    "id": "a2266f0e",
    "text": "店内でお召し上がりですか。"
  },
  {
    "id": "a2c0df4e",
    "text": "忘れる"
  },
  {
    "id": "a353a370",
    "text": "さらに"
  },
  {
    "id": "a3c39cc0",
    "text": "薬を飲まなければなりません。"
  },
  {
    "id": "a548f9f6",
    "text": "四百円です。あちらの席でお待ちください。"
  },
  {
    "id": "a55c4548",
    "text": "いる"
  },
  {
    "id": "a563f801",
    "text": "正しい"
  },
  {
    "id": "a631554a",
    "text": "最近"
  },
  {
    "id": "a6bcccd3",
    "text": "実は"
  },
  {
    "id": "a718eaee",
    "text": "眼鏡"
  },
  {
    "id": "a7258d9a",
    "text": "これは友達の車です。"
  },
  {
    "id": "a7962852",
    "text": "正直"
  },
  {
    "id": "a833e5c2",
    "text": "そのため"
  },
  {
    "id": "a9156554",
    "text": "恥ずかしい"
  },
  {
    "id": "a9511862",
    "text": "報告"
  },
  {
    "id": "a98ce24b",
    "text": "犬"
  },
  {
    "id": "a9c00693",
    "text": "おいしそうですね。じゃあ、それを二つお願いします。"
  },
  {
    "id": "a9f46ba2",
    "text": "ほとんど"
  },
  {
    "id": "aaa3f914",
    "text": "慎重"
  },
  {
    "id": "aacb02a7",
    "text": "航空便と船便がございますが、どちらになさいますか。"
  },
  {
    "id": "abfed075",
    "text": "はい。ホットコーヒーを一つください。"
  },
  {
    "id": "ac416a16",
    "text": "時間さえあれば手伝えます。"
  },
  {
    "id": "ac671418",
    "text": "使う"
  },
  {
    "id": "ac968fc8",
    "text": "そうですか。日本語が上手ですね。"
  },
  {
    "id": "ae0264cd",
    "text": "する"
  },
  {
    "id": "ae08bf8f",
    "text": "名前"
  },
  {
    "id": "ae12e026",
    "text": "驚く"
  },
  {
    "id": "ae450567",
    "text": "ただし"
  },
  {
    "id": "ae5f5f24",
    "text": "来年日本で働くつもりです。"
  },
  {
    "id": "ae879eba",
    "text": "はい。ありがとうございました。"
  },
  {
    "id": "aeac6084",
    "text": "便利な反面、危険も伴う。"
  },
  {
    "id": "aec39511",
    "text": "会う"
  },
  {
    "id": "aecd0495",
    "text": "なお"
  },
  {
    "id": "b017688b",
    "text": "楽しい"
  },
  {
    "id": "b06dc699",
    "text": "分かりました。資料にまとめて、明日までに共有してください。"
  },
  {
    "id": "b08b72d4",
    "text": "考えれば考えるほど分からなくなります。"
  },
  {
    "id": "b158931d",
    "text": "事故"
  },
  {
    "id": "b1c0b5ce",
    "text": "嫌いなわけではありませんが、あまり食べません。"
  },
  {
    "id": "b1eb43fc",
    "text": "覚える"
  },
  {
    "id": "b26e52e7",
    "text": "いわゆる"
  },
  {
    "id": "b30b1d5c",
    "text": "毎日"
  },
  {
    "id": "b34c6709",
    "text": "家"
  },
  {
    "id": "b40263fa",
    "text": "友達"
  },
  {
    "id": "b438ed2f",
    "text": "誰"
  },
  {
    "id": "b4ec3360",
    "text": "都合"
  },
  {
    "id": "b6419f3c",
    "text": "根拠"
  },
  {
    "id": "b6d9ad2c",
    "text": "支出"
  },
  {
    "id": "b7445276",
    "text": "日本語で説明することができますか。"
  },
  {
    "id": "b7b92923",
    "text": "ここまで壊れると、直しようがない。"
  },
  {
    "id": "b7baae9a",
    "text": "詳細が分かり次第、ご連絡いたします。"
  },
  {
    "id": "b7d52dda",
    "text": "この状況では計画を中止せざるを得ません。"
  },
  {
    "id": "b7e1db75",
    "text": "働く"
  },
  {
    "id": "b7f7a069",
    "text": "かしこまりました。本日中にお送りいたします。今後ともよろしくお願い申し上げます。"
  },
  {
    "id": "b81abc2d",
    "text": "残念"
  },
  {
    "id": "b8b0d4eb",
    "text": "生じる"
  },
  {
    "id": "b96f892e",
    "text": "承知いたしました。では、カスタマイズの範囲を中心に調整した案を作らせていただきます。"
  },
  {
    "id": "b9ad79a6",
    "text": "空港"
  },
  {
    "id": "bae1b178",
    "text": "これは「約束」と読みます。意味はpromiseです。"
  },
  {
    "id": "baefe7a6",
    "text": "そうですか。時間があったら行ってみます。"
  },
  {
    "id": "bb15b6d3",
    "text": "大切"
  },
  {
    "id": "bb6c94de",
    "text": "結果は努力次第です。"
  },
  {
    "id": "bbccbba0",
    "text": "安い"
  },
  {
    "id": "bc0ae996",
    "text": "それは私の傘ではありません。"
  },
  {
    "id": "bc4960a1",
    "text": "観点"
  },
  {
    "id": "bd92ea32",
    "text": "危ない"
  },
  {
    "id": "bd979f19",
    "text": "場所"
  },
  {
    "id": "bde0060a",
    "text": "いただきます"
  },
  {
    "id": "bed8a9a1",
    "text": "午後"
  },
  {
    "id": "bee510eb",
    "text": "感じる"
  },
  {
    "id": "bf0f3d87",
    "text": "郵便局"
  },
  {
    "id": "bf60f0ed",
    "text": "人"
  },
  {
    "id": "bfe4e80d",
    "text": "京都なら春が一番きれいですよ。"
  },
  {
    "id": "c018d12e",
    "text": "条件"
  },
  {
    "id": "c03a9a22",
    "text": "ここで切符を買うことができます。"
  },
  {
    "id": "c0bac85e",
    "text": "何も言わずに帰ってしまいました。"
  },
  {
    "id": "c0e38f7f",
    "text": "好き"
  },
  {
    "id": "c0e8959c",
    "text": "明日"
  },
  {
    "id": "c133cc2c",
    "text": "こちらの物件はいかがでしょうか。築十年ですが、中はリフォームされています。"
  },
  {
    "id": "c16e0695",
    "text": "週末"
  },
  {
    "id": "c1d4cd82",
    "text": "後者の場合、お客様への説明はどうしますか。"
  },
  {
    "id": "c26ee596",
    "text": "焦る"
  },
  {
    "id": "c27f5d49",
    "text": "予約"
  },
  {
    "id": "c2a528f9",
    "text": "サイズはいかがなさいますか。"
  },
  {
    "id": "c31f804f",
    "text": "これは何ですか。"
  },
  {
    "id": "c345bb10",
    "text": "場合によっては"
  },
  {
    "id": "c3e00786",
    "text": "状況は改善しつつあります。"
  },
  {
    "id": "c46bbb7a",
    "text": "調べる"
  },
  {
    "id": "c4754df5",
    "text": "根拠はありますか。"
  },
  {
    "id": "c480c4ec",
    "text": "かしこまりました"
  },
  {
    "id": "c534a1ce",
    "text": "交渉"
  },
  {
    "id": "c66005f6",
    "text": "昨日"
  },
  {
    "id": "c6a24cd3",
    "text": "たくさん"
  },
  {
    "id": "c6aee909",
    "text": "妥当"
  },
  {
    "id": "c6f58811",
    "text": "通う"
  },
  {
    "id": "c705529b",
    "text": "熱は何度くらいありましたか。"
  },
  {
    "id": "c7711eea",
    "text": "なるべく"
  },
  {
    "id": "c79c069c",
    "text": "妥協"
  },
  {
    "id": "c7ddbcbf",
    "text": "はじめまして。マイクです。こちらこそよろしくお願いします。"
  },
  {
    "id": "c8908a8e",
    "text": "早く寝たほうがいいですよ。"
  },
  {
    "id": "c90ac7dd",
    "text": "大変"
  },
  {
    "id": "c9722733",
    "text": "方法"
  },
  {
    "id": "c984999d",
    "text": "うん、大丈夫。どうしたの？"
  },
  {
    "id": "c99a2f28",
    "text": "週末は何かしましたか。"
  },
  {
    "id": "c9e31bb5",
    "text": "適当"
  },
  {
    "id": "ca8c3d8a",
    "text": "印象"
  },
  {
    "id": "caf253e3",
    "text": "なぜ弊社を志望されたんですか。"
  },
  {
    "id": "cb079a3f",
    "text": "どうぞ、聞かせてください。"
  },
  {
    "id": "cb92a056",
    "text": "明日までに出さなければなりません。"
  },
  {
    "id": "cbc76572",
    "text": "過ごす"
  },
  {
    "id": "cbca9e33",
    "text": "たくさん勉強したのに、試験に落ちました。"
  },
  {
    "id": "cc7e302e",
    "text": "疲れているなら休んだほうがいいです。"
  },
  {
    "id": "cd2b408c",
    "text": "鶏肉を甘いソースで煮た料理です。人気がありますよ。"
  },
  {
    "id": "cd561d1e",
    "text": "起きる"
  },
  {
    "id": "cd7e6d60",
    "text": "まっすぐですね。"
  },
  {
    "id": "cdc2f78b",
    "text": "述べる"
  },
  {
    "id": "cdcd0865",
    "text": "見通し"
  },
  {
    "id": "ce7324f9",
    "text": "確かに、一律だと不満が出かねないですね。"
  },
  {
    "id": "ce76ba70",
    "text": "はい、店内で。"
  },
  {
    "id": "ce8a1356",
    "text": "はい、そちらで結構です。二千三百円になります。"
  },
  {
    "id": "cefab9ab",
    "text": "図る"
  },
  {
    "id": "cf27f15a",
    "text": "ちょっと"
  },
  {
    "id": "cf980fdc",
    "text": "収入"
  },
  {
    "id": "d017c05c",
    "text": "はい。入社後の研修について詳しく教えていただけますか。"
  },
  {
    "id": "d05d4f15",
    "text": "対策"
  },
  {
    "id": "d05f78b0",
    "text": "何"
  },
  {
    "id": "d0b5c4d8",
    "text": "サポートは二年確保したいですね。そちらは譲れません。"
  },
  {
    "id": "d0c2d018",
    "text": "量が多すぎて食べきれません。"
  },
  {
    "id": "d1421c20",
    "text": "スミスと申します。スミスです。"
  },
  {
    "id": "d152ba9a",
    "text": "立場"
  },
  {
    "id": "d155b6bc",
    "text": "どうすればいいですか。"
  },
  {
    "id": "d2a035f9",
    "text": "見直す"
  },
  {
    "id": "d2f0bfcb",
    "text": "右に曲がると銀行があります。"
  },
  {
    "id": "d305eac8",
    "text": "土地の権利をめぐる争いが起きた。"
  },
  {
    "id": "d308bb20",
    "text": "確認"
  },
  {
    "id": "d3b9a1f1",
    "text": "少し"
  },
  {
    "id": "d475ea29",
    "text": "お客様のご要望に応じて対応いたします。"
  },
  {
    "id": "d4ec4e8a",
    "text": "お箸はお付けしますか。"
  },
  {
    "id": "d5084554",
    "text": "電車に傘を忘れてしまいました。"
  },
  {
    "id": "d5a47380",
    "text": "朝測ったら三十八度ありました。"
  },
  {
    "id": "d5f98368",
    "text": "駅に着いたら電話してください。"
  },
  {
    "id": "d647f24a",
    "text": "美術館"
  },
  {
    "id": "d79afcd4",
    "text": "内容を確認した上で、ご返事いたします。"
  },
  {
    "id": "d8385464",
    "text": "約束"
  },
  {
    "id": "d83a4e63",
    "text": "大事な会議なので、休むわけにはいきません。"
  },
  {
    "id": "d83a76aa",
    "text": "田中さんは来月引っ越すそうです。"
  },
  {
    "id": "d8d22bb0",
    "text": "すみません、このお弁当を温めてもらえますか。"
  },
  {
    "id": "d9228ac0",
    "text": "靴を履いたまま入らないでください。"
  },
  {
    "id": "d97b980d",
    "text": "静か"
  },
  {
    "id": "d9a71530",
    "text": "昨日から頭が痛くて、熱もあります。"
  },
  {
    "id": "d9c79186",
    "text": "後ろの人にも聞こえるように大きい声で話します。"
  },
  {
    "id": "da4a2779",
    "text": "今電話で話しています。"
  },
  {
    "id": "daabb41d",
    "text": "変える"
  },
  {
    "id": "db0f31da",
    "text": "二人です。禁煙席があればお願いします。"
  },
  {
    "id": "dbf0487c",
    "text": "子供"
  },
  {
    "id": "dc1b0b8f",
    "text": "検討"
  },
  {
    "id": "dc825a2d",
    "text": "せっかく"
  },
  {
    "id": "dc9c8850",
    "text": "差し支えなければ"
  },
  {
    "id": "dca538a8",
    "text": "経験"
  },
  {
    "id": "dd6ed700",
    "text": "認識"
  },
  {
    "id": "dd7bc3e3",
    "text": "寒い"
  },
  {
    "id": "dd9965f4",
    "text": "把握"
  },
  {
    "id": "de07b0ca",
    "text": "図書館で本を読みます。"
  },
  {
    "id": "de6f8fcd",
    "text": "ありがとうございます。保険証は受付に出しました。"
  },
  {
    "id": "de702a09",
    "text": "このボタンを押しさえすれば始まります。"
  },
  {
    "id": "dec9e8bf",
    "text": "歩いて十分くらいです。"
  },
  {
    "id": "df051bab",
    "text": "ここに座ってもいいですか。"
  },
  {
    "id": "df2f3d2d",
    "text": "心配"
  },
  {
    "id": "df542d3f",
    "text": "伴う"
  },
  {
    "id": "e0541ec7",
    "text": "会議"
  },
  {
    "id": "e05b2894",
    "text": "部屋"
  },
  {
    "id": "e15f38f9",
    "text": "省く"
  },
  {
    "id": "e1645b3b",
    "text": "やっぱり"
  },
  {
    "id": "e1edc3d1",
    "text": "先日の件ですが、納品物に不備がありました。どういうことでしょうか。"
  },
  {
    "id": "e226e168",
    "text": "同感です。次の会議で一緒に提案してみませんか。"
  },
  {
    "id": "e2341da5",
    "text": "それに"
  },
  {
    "id": "e24ff2ea",
    "text": "毎朝走るようになりました。"
  },
  {
    "id": "e2766f4c",
    "text": "急いでいるので、航空便でお願いします。"
  },
  {
    "id": "e2924efe",
    "text": "十分"
  },
  {
    "id": "e2a00a69",
    "text": "手紙"
  },
  {
    "id": "e2e7f5de",
    "text": "及ぼす"
  },
  {
    "id": "e397fe57",
    "text": "権利"
  },
  {
    "id": "e39d8d52",
    "text": "公園に子供がいます。"
  },
  {
    "id": "e3ad6558",
    "text": "壊れる"
  },
  {
    "id": "e3da4679",
    "text": "現代社会における情報の役割は大きい。"
  },
  {
    "id": "e3dcb748",
    "text": "四人です。土曜日の夜七時は空いていますか。"
  },
  {
    "id": "e44a4c24",
    "text": "お金"
  },
  {
    "id": "e466d549",
    "text": "思ったより高いですね。もう少し安い物件も見せていただけますか。"
  },
  {
    "id": "e4f3abca",
    "text": "聞く"
  },
  {
    "id": "e5105f29",
    "text": "銀行"
  },
  {
    "id": "e52e2ebc",
    "text": "具体的にはどの部分でしょうか。"
  },
  {
    "id": "e552f401",
    "text": "約束した以上、断るわけにはいかない。"
  },
  {
    "id": "e591e90e",
    "text": "彼の意見は正しいと認めざるを得ない。"
  },
  {
    "id": "e5da4130",
    "text": "一割となりますと、現在の仕様のままではお応えしかねます。ただ、内容を見直せばご対応できる可能性はございます。"
  },
  {
    "id": "e5ec4110",
    "text": "優先度の高い機能は予定通り提供できる点を強調した上で、代替案をお示ししたいと思います。"
  },
  {
    "id": "e6033891",
    "text": "写真"
  },
  {
    "id": "e65ba1c6",
    "text": "引き受けたものの、どう進めればいいか分からない。"
  },
  {
    "id": "e66f2b63",
    "text": "選ぶ"
  },
  {
    "id": "e7143790",
    "text": "友達と映画を見に行きました。それから買い物もしました。"
  },
  {
    "id": "e79528fc",
    "text": "今晩飲みに行きませんか。"
  },
  {
    "id": "e7a82e33",
    "text": "趣味"
  },
  {
    "id": "e7d18b59",
    "text": "高い"
  },
  {
    "id": "e85227df",
    "text": "話す"
  },
  {
    "id": "e92dcb80",
    "text": "引っ越す"
  },
  {
    "id": "e962833b",
    "text": "維持"
  },
  {
    "id": "e9a26378",
    "text": "細かい"
  },
  {
    "id": "e9babbf9",
    "text": "諦める"
  },
  {
    "id": "ea8339f5",
    "text": "著しい"
  },
  {
    "id": "eabc2e01",
    "text": "電車で足を踏まれました。"
  },
  {
    "id": "ebc03591",
    "text": "契約に際して、内容をご確認ください。"
  },
  {
    "id": "ec123194",
    "text": "供給"
  },
  {
    "id": "ec9899f1",
    "text": "電話"
  },
  {
    "id": "ecd476b4",
    "text": "すみません、この荷物をイギリスに送りたいんですが。"
  },
  {
    "id": "ed721028",
    "text": "ここで休みましょう。"
  },
  {
    "id": "ede28370",
    "text": "仕事を進める上で大切なのは報告です。"
  },
  {
    "id": "ede648cb",
    "text": "彼はゲームばかりしています。"
  },
  {
    "id": "ee258446",
    "text": "病院"
  },
  {
    "id": "ef7ffaae",
    "text": "電車が遅れるかもしれません。"
  },
  {
    "id": "f0371a23",
    "text": "情報"
  },
  {
    "id": "f09f1a67",
    "text": "会議で意見を聞かれました。"
  },
  {
    "id": "f0a84a0b",
    "text": "在宅勤務、うちもそろそろ見直す時期かもしれませんね。"
  },
  {
    "id": "f18d78ce",
    "text": "友達と映画を見ました。"
  },
  {
    "id": "f25770e1",
    "text": "約束したのに来なかった。"
  },
  {
    "id": "f37074f9",
    "text": "出発に際して注意事項をご説明します。"
  },
  {
    "id": "f3814909",
    "text": "連絡"
  },
  {
    "id": "f3afbb2d",
    "text": "そうだよね。とりあえず情報だけ集めてみようかな。"
  },
  {
    "id": "f3cbdf5b",
    "text": "課題"
  },
  {
    "id": "f49408bf",
    "text": "参加"
  },
  {
    "id": "f4d3c2a6",
    "text": "働き方が大きく変わりつつある。"
  },
  {
    "id": "f5025715",
    "text": "古い"
  },
  {
    "id": "f525f297",
    "text": "私も近い意見です。ただ、職種に応じて柔軟に決められる制度のほうが好ましいと感じます。"
  },
  {
    "id": "f5f993c0",
    "text": "切符"
  },
  {
    "id": "f61bcdff",
    "text": "御社の海外事業に興味があり、自分の経験を生かせると考えたからです。"
  },
  {
    "id": "f69a0cce",
    "text": "親切"
  },
  {
    "id": "f6ad7d98",
    "text": "そのご要望にはお応えしかねます。"
  },
  {
    "id": "f71b164f",
    "text": "人口の増加に伴って、住宅の需要も高まっています。"
  },
  {
    "id": "f75dee62",
    "text": "締め切りが重なったときの調整です。優先順位を決めて、チームで分担するようにしました。"
  },
  {
    "id": "f8789fa7",
    "text": "補う"
  },
  {
    "id": "f89aceaa",
    "text": "や・く・そ・く。ノートに書いてください。"
  },
  {
    "id": "f8a2c978",
    "text": "解決"
  },
  {
    "id": "f931cbe9",
    "text": "実施"
  },
  {
    "id": "f9e20170",
    "text": "スミス様ですね。では、土曜日の七時半にお待ちしております。"
  },
  {
    "id": "fbaf7e46",
    "text": "とにかく"
  },
  {
    "id": "fbc039ce",
    "text": "はい。制度を変える上で大切なのは、決める過程を見えるようにすることだと思います。"
  },
  {
    "id": "fcbbe756",
    "text": "ここで写真を撮らないでください。"
  },
  {
    "id": "fd15bd71",
    "text": "雨が降りそうです。"
  },
  {
    "id": "fd1d1066",
    "text": "敷金、礼金、仲介手数料を含めて、三十万円ほど見ておいてください。"
  },
  {
    "id": "fd1e0fb9",
    "text": "この度はご迷惑をおかけし、誠に申し訳ございません。"
  },
  {
    "id": "fd904176",
    "text": "二点実施いたします。一つは二人による確認の義務化、もう一つはダッシュボードによる進捗の見える化です。"
  },
  {
    "id": "fd9171a1",
    "text": "効く"
  },
  {
    "id": "fdb6ca03",
    "text": "遠慮"
  },
  {
    "id": "fdd453ce",
    "text": "午前"
  },
  {
    "id": "fdd981eb",
    "text": "夏より冬のほうが好きです。"
  },
  {
    "id": "ff767613",
    "text": "音楽を聞きながら散歩します。"
  },
  {
    "id": "ffcf17a4",
    "text": "旅行"
  },
  {
    "id": "ffec2a54",
    "text": "食べ物"
  }
]
